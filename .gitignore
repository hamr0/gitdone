# Environment
.env
.env.local
.env.*.local

# Dependencies
node_modules/
yarn.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build
dist/
build/

# Testing
coverage/
.nyc_output/

# Runtime
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Data files
/data/stats.json
/data/uploads/*
!/data/uploads/.gitkeep
/data/events/*
!/data/events/.gitkeep
/data/magic_tokens.json

# OS
Thumbs.db
.DS_Store

# Email samples — may contain private content
*.eml

# Cryptographic key material — never commit
*.private
*.pem
*_rsa
*_rsa.pub
*.p12
*.pfx
# DKIM artifacts (opendkim-genkey outputs)
*._domainkey*
**/default.txt
**/default.private
# EXCEPTION: test-only DKIM keypair fixture used by the e2e proof
# test. The private key here is bound to test.example.com (a domain
# we don't operate) and is NEVER served from prod DNS, so it has no
# operational value to an attacker.
!app/tests/fixtures/dkim/*.private.pem

# Dev mode artifacts (not shipped)
/data-dev/
app/data-dev/
/dev-feedback.log
app/dev-feedback.log
