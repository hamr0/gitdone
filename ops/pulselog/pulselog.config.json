{
  "output": {
    "file": "/var/lib/gitdone/logs/health.jsonl",
    "maxBytes": 5000000,
    "heartbeat": false
  },
  "alert": {
    "email": "avoidaccess@gmail.com",
    "from": "alerts@signedreply.com",
    "app": "gitdone",
    "logTail": "/var/lib/gitdone/logs/errors.jsonl"
  },
  "retry": { "retries": 1, "retryDelayMs": 1000 },
  "checks": [
    { "type": "service", "name": "web", "enabled": true, "unit": "gitdone-web.service", "timeoutMs": 10000 },
    { "type": "service", "name": "ots-timer", "enabled": true, "unit": "gitdone-ots-upgrade.timer", "timeoutMs": 10000 },
    { "type": "http", "name": "api", "enabled": true, "url": "http://127.0.0.1:3001/health", "expectStatus": 200, "timeoutMs": 10000 },
    { "type": "disk", "name": "disk-root", "enabled": true, "path": "/", "maxPercent": 80 },
    { "type": "disk", "name": "disk-data", "enabled": true, "path": "/var/lib/gitdone", "maxPercent": 80 },
    { "type": "ssl", "name": "cert", "enabled": true, "host": "signedreply.com", "port": 443, "warnDays": 14 },
    { "type": "command", "name": "mailq", "enabled": true, "command": "sh", "args": ["-c", "test $(mailq | grep -c '^[A-F0-9]') -lt 50"] },
    { "type": "command", "name": "log-errors", "enabled": true, "command": "sh", "args": ["-c", "test $(journalctl -u gitdone-web.service --since '1 hour ago' -p err --no-pager -q 2>/dev/null | wc -l) -eq 0"] },
    { "type": "command", "name": "ots-backlog", "enabled": true, "command": "sh", "args": ["-c", "test $(find /var/lib/gitdone/repos -name '*.ots' -type f -mmin +2880 -size -1024c 2>/dev/null | wc -l) -eq 0"] }
  ],
  "digest": {
    "app": "gitdone",
    "history": "/var/lib/gitdone/logs/stats.jsonl",
    "email": "avoidaccess@gmail.com",
    "from": "alerts@signedreply.com",
    "weeks": 4,
    "metricsCommand": {
      "command": "/usr/bin/node",
      "args": ["/opt/gitdone/app/bin/stats.js", "--metrics-json"],
      "timeoutMs": 30000
    },
    "metrics": [
      { "name": "orgs" },
      { "name": "rcpts" },
      { "name": "events" },
      { "name": "pending" },
      { "name": "open" },
      { "name": "completed" },
      { "name": "steps_done" },
      { "name": "attest_replies" }
    ],
    "flightlog": { "file": "/var/lib/gitdone/logs/errors.jsonl", "flagAtLeast": 10 }
  },
  "backup": {
    "app": "gitdone",
    "dir": "/var/lib/gitdone/backups",
    "name": "gitdone-backup",
    "include": [
      "/var/lib/gitdone/events",
      "/var/lib/gitdone/repos",
      { "path": "/var/lib/gitdone/magic_tokens", "optional": true },
      "/etc/letsencrypt",
      "/etc/opendkim/keys",
      "/etc/default/gitdone-web"
    ],
    "command": "sh",
    "args": ["-c", "test -n \"$(ls -A /var/lib/gitdone/repos 2>/dev/null)\" || { echo 'backup guard: repos/ is empty — refusing to publish' >&2; exit 1; }"],
    "keepLast": 7,
    "keepDays": 30,
    "minBytes": 4096,
    "history": "/var/lib/gitdone/logs/backup.jsonl",
    "email": "avoidaccess@gmail.com",
    "from": "alerts@signedreply.com"
  }
}
